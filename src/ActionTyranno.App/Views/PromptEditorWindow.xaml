<Window x:Class="ActionTyranno.App.Views.PromptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프롬프트 관리" Height="620" Width="820" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="NewButton" AutomationProperties.AutomationId="NewPromptButton" Content="＋ 새 프롬프트"
                        Style="{StaticResource FlatButtonBase}" Click="OnNewClick" Margin="0,0,0,6"/>
                <Button x:Name="DeleteButton" AutomationProperties.AutomationId="DeletePromptButton" Content="삭제"
                        Style="{StaticResource FlatButtonBase}" Foreground="{StaticResource DangerText}" Click="OnDeleteClick"/>
            </StackPanel>
            <ListBox x:Name="PromptListBox" AutomationProperties.AutomationId="PromptListBox"
                     Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}"
                     Foreground="{StaticResource TextPrimary}" DisplayMemberPath="Name"
                     SelectionChanged="OnSelectionChanged"/>
        </DockPanel>

        <Grid Grid.Column="2" x:Name="EditorGrid" IsEnabled="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="이름" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox Grid.Row="1" x:Name="NameTextBox" AutomationProperties.AutomationId="PromptNameTextBox" Margin="0,0,0,12"/>

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Run Text="시스템 프롬프트" FontWeight="Bold"/>
                    <Run Text="  AI가 따라야 할 규칙 (보고 양식, 추출 기준 등)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                </TextBlock>
                <TextBox x:Name="SystemPromptTextBox" AutomationProperties.AutomationId="SystemPromptTextBox"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" FontFamily="Consolas"/>
            </DockPanel>

            <TextBlock Grid.Row="3" Margin="0,12,0,4">
                <Run Text="요청 문구" FontWeight="Bold"/>
                <Run Text="  {LogText} 처럼 변수를 넣을 수 있습니다" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
            </TextBlock>
            <TextBox Grid.Row="4" x:Name="UserPromptTextBox" AutomationProperties.AutomationId="UserPromptTextBox"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" FontFamily="Consolas"/>

            <TextBlock Grid.Row="5" x:Name="StatusText" Margin="0,8,0,0" Foreground="{StaticResource TextSecondary}" FontSize="12"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="SaveButton" AutomationProperties.AutomationId="SavePromptButton" Content="저장"
                        Style="{StaticResource PrimaryButton}" Width="100" Height="36" Margin="0,0,8,0" Click="OnSaveClick"/>
                <Button AutomationProperties.AutomationId="ClosePromptButton" Content="닫기"
                        Style="{StaticResource FlatButtonBase}" Width="80" Height="36" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
