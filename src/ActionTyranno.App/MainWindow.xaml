<Window x:Class="ActionTyranno.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ActionTyranno.App"
        mc:Ignorable="d"
        Title="ActionTyranno" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" VerticalAlignment="Top">
        <Button x:Name="PickCoordinateButton" Content="위치 지정" Width="140" Height="36"
                HorizontalAlignment="Left" Click="OnPickCoordinateClick"/>
        <TextBlock x:Name="ResultText" Margin="0,16,0,0" FontSize="16" Text="좌표를 지정해보세요."/>
    </StackPanel>
</Window>
